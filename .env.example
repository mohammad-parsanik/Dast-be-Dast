# Copy to .env (never commit .env).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=fund.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://fund.example.com
# Admin two-factor login (on by default when DEBUG is off)
DJANGO_OTP_REQUIRED=1

POSTGRES_DB=dastbedast
POSTGRES_USER=dastbedast
POSTGRES_PASSWORD=change-me

# Policy (rials)
FUND_SAFETY_MARGIN_RIALS=0
FUND_FORECAST_HORIZON_MONTHS=12
FUND_BULK_TRANSFER_FORMAT=placeholder_csv

# Bale bot token from @botfather. Admins are linked to users in the admin panel («مدیران در بازو»);
# each admin finds their Bale id by sending /whoami to the bot.
BALE_BOT_TOKEN=
# Safir (Phase 7)
# SAFIR_API_KEY=
